# ============================================================
# YouTube Anomaly Bot / Standalone GUI
# ============================================================

# --- Telegram (optional for GUI-only mode) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_USER_IDS=

# --- YouTube ---
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CACHE_TTL_MINUTES=15

# --- Proxy ---
# Multiple proxies: comma, semicolon or newline separated.
# Supported: http://, https://, socks5://
PROXY=http://user:pass@host:3128
PROXY_MODE=failover
PROXY_HEALTHCHECK_URL=https://www.youtube.com/generate_204
PROXY_HEALTHCHECK_TIMEOUT=8
PROXY_HEALTHCHECK_INTERVAL=60

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/yt_anomaly_bot

# --- Analysis Defaults ---
DEFAULT_THRESHOLD=1.8
DEFAULT_MIN_VIEWS=5000
DEFAULT_MIN_AGE_DAYS=7
DEFAULT_PERIOD_DAYS=90
DEFAULT_BASELINE_METHOD=median
DEFAULT_INCLUDE_SHORTS=false
DEFAULT_INCLUDE_FRESH_IN_BASELINE=false

# --- Telegram scheduler ---
SCHEDULE_INTERVAL=weekly

# --- Standalone GUI polling ---
WEB_AUTO_SCAN=true
WEB_POLL_INTERVAL_MINUTES=60
WEB_SCAN_ON_START=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
